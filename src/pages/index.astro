---
import "../styles/global.css";
import { siteHref } from "../lib/site-url";

const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The Git Fanta website." />
    <title>Git Fanta</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={siteHref("/", baseUrl)}>Git Fanta</a>
      <nav aria-label="Primary navigation">
        <a href={siteHref("/#main-content", baseUrl)}>Overview</a>
      </nav>
    </header>
    <main id="main-content" class="page-shell">
      <p class="eyebrow">Website foundation</p>
      <h1>Git Fanta</h1>
      <p>
        The accessible static site foundation is ready for the product content
        phase.
      </p>
    </main>
    <footer class="site-footer">
      <p>Git Fanta is free software.</p>
    </footer>
  </body>
</html>
