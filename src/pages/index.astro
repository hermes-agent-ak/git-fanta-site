---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Container from "../components/ui/Container.astro";
import { siteHref } from "../lib/site-url";

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Git Fanta"
  description="The Git Fanta website foundation."
  mainClass="site-main"
>
  <SiteHeader slot="header" baseUrl={baseUrl} />

  <Container as="section" size="xl">
    <div class="max-w-3xl py-16 sm:py-24 lg:py-32">
      <p class="eyebrow">Temporary foundation placeholder</p>
      <h1
        class="max-w-3xl text-display font-extrabold leading-none tracking-tight text-fg-primary"
      >
        Git Fanta
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-fg-muted sm:text-xl">
        The accessible static site foundation is ready for the later content
        phases.
      </p>

      <section class="mt-14" aria-labelledby="foundation-preview-heading">
        <div class="mb-6">
          <p class="eyebrow">Replaceable component preview</p>
          <h2
            id="foundation-preview-heading"
            class="text-title font-bold text-fg-primary"
          >
            Semantic interface building blocks
          </h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          <Card tone="accent" interactive>
            <h3 class="text-lg font-bold text-fg-primary">Link mode</h3>
            <p class="mt-3 text-fg-muted">
              This temporary preview exercises a keyboard-reachable link.
            </p>
            <div class="mt-5">
              <Button
                href={siteHref("/#main-content", baseUrl)}
                variant="secondary"
              >
                Return to content
              </Button>
            </div>
          </Card>

          <Card tone="success">
            <h3 class="text-lg font-bold text-fg-primary">Native mode</h3>
            <p class="mt-3 text-fg-muted">
              This temporary preview keeps native button semantics intact.
            </p>
            <div class="mt-5">
              <Button
                variant="ghost"
                disabled
                ariaLabel="Preview action unavailable"
              >
                Preview action
              </Button>
            </div>
          </Card>
        </div>
      </section>
    </div>
  </Container>

  <SiteFooter slot="footer" baseUrl={baseUrl} />
</BaseLayout>
