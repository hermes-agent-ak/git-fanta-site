---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/pages/HomePage.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import { assetManifest } from "../content/assets";
import { approvedFeatures } from "../content/features";
import { product } from "../content/product";
import { createPageMetadata } from "../lib/metadata";
import { loadLatestRelease } from "../lib/releases/release-loader";

const baseUrl = import.meta.env.BASE_URL;
const latestRelease = await loadLatestRelease();
const showcase = assetManifest.find((asset) => asset.id === "product-showcase");

if (!showcase) {
  throw new Error(
    "The product showcase asset is missing from the asset manifest.",
  );
}

const metadata = createPageMetadata({
  title: `${product.name} — ${product.tagline}`,
  description: product.summary,
  canonicalPath: "/",
  baseUrl,
  site: Astro.site,
  includeSoftwareApplication: true,
});
---

<BaseLayout
  title={metadata.title}
  description={metadata.description}
  metadata={metadata}
  mainClass="site-main"
>
  <SiteHeader slot="header" baseUrl={baseUrl} />
  <HomePage
    product={product}
    features={approvedFeatures}
    latestRelease={latestRelease}
    showcase={showcase}
    baseUrl={baseUrl}
  />
  <SiteFooter slot="footer" baseUrl={baseUrl} />
</BaseLayout>
