---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DownloadPage from "../../components/pages/DownloadPage.astro";
import SiteFooter from "../../components/site/SiteFooter.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import { createPageMetadata } from "../../lib/metadata";
import { buildDownloadPageModel } from "../../lib/downloads";
import { loadLatestRelease } from "../../lib/releases/release-loader";

const baseUrl = import.meta.env.BASE_URL;
const latestRelease = await loadLatestRelease();
const model = buildDownloadPageModel(latestRelease);
const metadata = createPageMetadata({
  title: `Download Git Fanta ${latestRelease.version}`,
  description:
    "Choose a verified Git Fanta release artifact for Windows, Linux, macOS, or Python.",
  canonicalPath: "/download/",
  baseUrl,
  site: Astro.site,
});
---

<BaseLayout
  title={metadata.title}
  description={metadata.description}
  metadata={metadata}
  mainClass="site-main"
>
  <SiteHeader slot="header" baseUrl={baseUrl} />
  <DownloadPage model={model} />
  <SiteFooter slot="footer" baseUrl={baseUrl} />
</BaseLayout>
