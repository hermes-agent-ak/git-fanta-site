---
import { siteHref } from "../../lib/site-url";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

interface Props {
  baseUrl?: string;
}

const { baseUrl = import.meta.env.BASE_URL } = Astro.props;
---

<Container as="section" size="md">
  <div class="not-found-page page-experience">
    <p class="eyebrow">404 / branch not found</p>
    <h1 class="text-display-sm">This route does not exist.</h1>
    <p class="lede">
      The page may have moved, but the next useful commit is still close by.
    </p>
    <div class="not-found-page__actions">
      <Button href={siteHref("/", baseUrl)} size="lg">Return home</Button>
      <Button
        href={siteHref("/download/", baseUrl)}
        variant="secondary"
        size="lg"
      >
        Browse downloads
      </Button>
    </div>
  </div>
</Container>
