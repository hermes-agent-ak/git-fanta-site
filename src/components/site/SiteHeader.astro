---
import Container from "../ui/Container.astro";
import {
  navigationItems,
  navigationHref,
  type NavigationItem,
} from "../../lib/navigation";
import { assetManifest } from "../../content/assets";
import { product } from "../../content/product";
import { siteHref } from "../../lib/site-url";

interface Props {
  baseUrl?: string;
}

const { baseUrl = import.meta.env.BASE_URL } = Astro.props;
const currentPath = Astro.url.pathname;
const brandLogo = assetManifest.find((asset) => asset.id === "brand-logo");

if (!brandLogo || brandLogo.status !== "ready" || !brandLogo.targetPath) {
  throw new Error("The ready brand logo is missing from the asset manifest.");
}

const brandLogoHref = siteHref(
  brandLogo.targetPath.replace(/^public/, ""),
  baseUrl,
);

function normalizedPath(path: string): string {
  const withoutHash = path.split("#", 1)[0] ?? "/";
  const trimmed = withoutHash.replace(/\/+$/, "");
  return trimmed || "/";
}

function isCurrent(item: NavigationItem): boolean {
  if (item.external || !item.currentWhen) {
    return false;
  }

  return item.currentWhen.some((pattern) => {
    const expectedPath = siteHref(pattern, baseUrl);
    return normalizedPath(currentPath) === normalizedPath(expectedPath);
  });
}
---

<header class="border-b border-border-normal bg-bg-page">
  <Container size="xl">
    <div class="flex flex-wrap items-center justify-between gap-4 py-5">
      <a
        class="brand-link inline-flex items-center gap-3 rounded-sm text-lg font-extrabold tracking-tight text-fg-primary no-underline hover:text-accent-orange"
        href={siteHref("/", baseUrl)}
        aria-label={`${product.name} home`}
      >
        <img
          class="brand-logo h-10 w-10 shrink-0 object-contain sm:h-12 sm:w-12 lg:h-14 lg:w-14"
          src={brandLogoHref}
          alt=""
          aria-hidden="true"
          decoding="async"
        />
        <span>{product.name}</span>
      </a>
      <nav aria-label="Primary">
        <ul
          class="m-0 flex flex-wrap items-center justify-end gap-x-4 gap-y-2 p-0 text-sm font-medium text-fg-muted"
        >
          {
            navigationItems.map((item) => (
              <li>
                <a
                  class="rounded-sm px-1 py-1 hover:text-accent-orange"
                  href={navigationHref(item, baseUrl)}
                  aria-current={isCurrent(item) ? "page" : undefined}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>
