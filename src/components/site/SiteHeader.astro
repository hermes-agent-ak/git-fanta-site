---
import Container from "../ui/Container.astro";
import {
  navigationItems,
  navigationHref,
  type NavigationItem,
} from "../../lib/navigation";
import { assetManifest } from "../../content/assets";
import { product } from "../../content/product";
import { siteHref } from "../../lib/site-url";

interface Props {
  baseUrl?: string;
}

const { baseUrl = import.meta.env.BASE_URL } = Astro.props;
const currentPath = Astro.url.pathname;
const brandLogo = assetManifest.find((asset) => asset.id === "brand-logo");

if (!brandLogo || brandLogo.status !== "ready" || !brandLogo.targetPath) {
  throw new Error("The ready brand logo is missing from the asset manifest.");
}

const brandLogoHref = siteHref(
  brandLogo.targetPath.replace(/^public/, ""),
  baseUrl,
);
const navigationGroups = [
  {
    label: "Site",
    items: navigationItems.filter((item) => !item.external),
  },
  {
    label: "Project links",
    items: navigationItems.filter((item) => item.external),
  },
] as const;

function normalizedPath(path: string): string {
  const withoutHash = path.split("#", 1)[0] ?? "/";
  const trimmed = withoutHash.replace(/\/+$/, "");
  return trimmed || "/";
}

function isCurrent(item: NavigationItem): boolean {
  if (item.external || !item.currentWhen) {
    return false;
  }

  return item.currentWhen.some((pattern) => {
    const expectedPath = siteHref(pattern, baseUrl);
    return normalizedPath(currentPath) === normalizedPath(expectedPath);
  });
}
---

<header
  class="site-header border-b border-border-normal bg-bg-page"
  data-site-header
>
  <Container size="xl">
    <div class="site-header__shell">
      <a
        class="brand-link inline-flex items-center gap-3 rounded-sm text-lg font-extrabold tracking-tight text-fg-primary no-underline hover:text-accent-orange"
        href={siteHref("/", baseUrl)}
        aria-label={`${product.name} home`}
      >
        <img
          class="brand-logo h-10 w-10 shrink-0 object-contain sm:h-12 sm:w-12 lg:h-14 lg:w-14"
          src={brandLogoHref}
          alt=""
          aria-hidden="true"
          decoding="async"
        />
        <span>{product.name}</span>
      </a>
      <button
        class="site-header__toggle"
        type="button"
        aria-label="Open primary navigation"
        aria-expanded="false"
        aria-controls="primary-navigation"
        data-site-nav-toggle
        hidden
      >
        <span
          class="site-header__toggle-icon"
          data-motion="navigation-toggle"
          aria-hidden="true"
        >
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
      <nav
        id="primary-navigation"
        class="site-header__nav"
        aria-label="Primary"
        data-site-nav-panel
      >
        {
          navigationGroups.map((group) => (
            <div class="site-header__nav-group">
              <p class="site-header__nav-label">{group.label}</p>
              <ul class="site-header__nav-list">
                {group.items.map((item) => (
                  <li>
                    <a
                      class="site-header__nav-link"
                      href={navigationHref(item, baseUrl)}
                      aria-current={isCurrent(item) ? "page" : undefined}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                    >
                      <span>{item.label}</span>
                      {item.external ? (
                        <span
                          class="site-header__external-icon"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      ) : null}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
  </Container>
</header>

<script is:inline>
  const mobileNavigation = window.matchMedia("(max-width: 63.99rem)");

  document.querySelectorAll("[data-site-header]").forEach((header) => {
    const toggle = header.querySelector("[data-site-nav-toggle]");
    const panel = header.querySelector("[data-site-nav-panel]");

    if (
      !(header instanceof HTMLElement) ||
      !(toggle instanceof HTMLButtonElement) ||
      !(panel instanceof HTMLElement)
    ) {
      return;
    }

    const setOpen = (open) => {
      header.dataset.siteNavState = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? "Close primary navigation" : "Open primary navigation",
      );
    };

    const synchronizeLayout = () => {
      if (mobileNavigation.matches) {
        setOpen(false);
        return;
      }

      delete header.dataset.siteNavState;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open primary navigation");
    };

    toggle.hidden = false;
    synchronizeLayout();

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("pointerdown", (event) => {
      if (
        header.dataset.siteNavState === "open" &&
        event.target instanceof Node &&
        !header.contains(event.target)
      ) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || header.dataset.siteNavState !== "open") {
        return;
      }

      setOpen(false);
      toggle.focus();
    });

    mobileNavigation.addEventListener("change", synchronizeLayout);
  });
</script>
