---
import Container from "../ui/Container.astro";
import { navigationItems, navigationHref } from "../../lib/navigation";

interface Props {
  baseUrl?: string;
}

const { baseUrl = import.meta.env.BASE_URL } = Astro.props;
const externalItems = navigationItems.filter((item) => item.external);
---

<footer class="border-t border-border-normal bg-bg-page text-fg-muted">
  <Container size="xl">
    <div
      class="flex flex-col gap-5 py-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="m-0 text-sm">Git Fanta website foundation preview.</p>
      <nav aria-label="Footer links">
        <ul class="m-0 flex flex-wrap gap-x-4 gap-y-2 p-0 text-sm">
          {
            externalItems.map((item) => (
              <li>
                <a
                  class="rounded-sm hover:text-accent-orange"
                  href={navigationHref(item, baseUrl)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</footer>
