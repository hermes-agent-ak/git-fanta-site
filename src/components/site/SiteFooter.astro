---
import Container from "../ui/Container.astro";
import { navigationItems, navigationHref } from "../../lib/navigation";

interface Props {
  baseUrl?: string;
}

const { baseUrl = import.meta.env.BASE_URL } = Astro.props;
const internalItems = navigationItems.filter((item) => !item.external);
const externalItems = navigationItems.filter((item) => item.external);
---

<footer class="border-t border-border-normal bg-bg-page text-fg-muted">
  <Container size="xl">
    <div
      class="flex flex-col gap-5 py-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="m-0 text-sm font-semibold text-fg-primary">Git Fanta</p>
        <p class="m-0 mt-1 text-sm">The highly caffeinated Git GUI.</p>
      </div>
      <nav class="hidden lg:block" aria-label="Footer links">
        <ul class="m-0 flex flex-wrap gap-x-4 gap-y-2 p-0 text-sm">
          {
            [...internalItems, ...externalItems].map((item) => (
              <li>
                <a
                  class="rounded-sm hover:text-accent-orange"
                  href={navigationHref(item, baseUrl)}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</footer>
