---
import type {
  ExperienceNode,
  ExperienceTone,
} from "../../lib/experience-sections";

interface Props {
  node: ExperienceNode;
  tone: ExperienceTone;
  decorative?: boolean;
  active?: boolean;
}

const { node, tone, decorative = true, active = false } = Astro.props;
---

<span
  class:list={[
    "commit-marker",
    `commit-marker--${node}`,
    `commit-marker--${tone}`,
  ]}
  data-commit-marker
  data-active={active ? "true" : undefined}
  aria-hidden={decorative ? "true" : undefined}></span>
