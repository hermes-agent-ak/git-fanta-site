---
import {
  resolveExperienceSectionId,
  type ExperienceSection,
} from "../../lib/experience-sections";

interface Props {
  sections: readonly ExperienceSection[];
  currentId?: string;
}

const { sections, currentId } = Astro.props;
const activeId = resolveExperienceSectionId(sections, currentId);

function shortRef(ref: string): string {
  return ref.replace("refs/heads/", "");
}
---

<nav class="branchline-nav" aria-label="On this page" data-branchline-nav>
  <div class="branchline-nav__surface">
    <div class="branchline-nav__body">
      <div class="branchline-nav__intro">
        <p class="eyebrow">Page route / {sections.length} sections</p>
        <p>
          Follow the product story commit by commit. Refs are visual metadata,
          not live repository state.
        </p>
      </div>
      <ol class="branchline-nav__list">
        {
          sections.map((section) => {
            const isCurrent = section.id === activeId;

            return (
              <li class="branchline-nav__item">
                <a
                  class="branchline-nav__link"
                  href={section.href}
                  aria-label={section.ariaLabel}
                  aria-current={isCurrent ? "location" : undefined}
                  data-active={isCurrent ? "true" : "false"}
                  data-branchline-ref={section.ref}
                  data-branchline-tone={section.tone}
                  data-node={section.node}
                >
                  <span
                    class:list={[
                      "branchline-nav__node",
                      `branchline-nav__node--${section.tone}`,
                    ]}
                    aria-hidden="true"
                  />
                  <span class="branchline-nav__label">{section.label}</span>
                  <code>{shortRef(section.ref)}</code>
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</nav>

<script>
  import "./branchline-enhancement";
</script>
