---
import type { AssetRecord } from "../../content/assets";
import { siteHref } from "../../lib/site-url";

interface Props {
  showcase: AssetRecord;
  baseUrl?: string;
}

const { showcase, baseUrl = import.meta.env.BASE_URL } = Astro.props;
const showcasePath = showcase.targetPath?.replace(/^public/, "");
---

<section
  id="product-showcase"
  class="page-section page-section--showcase"
  aria-labelledby="product-showcase-heading"
  data-experience-section
>
  <div class="section-heading-row">
    <div>
      <p class="eyebrow">Product / derived project media</p>
      <h2 id="product-showcase-heading">A Git GUI with room to think</h2>
    </div>
    <span class="section-ref">refs/heads/feature/ui</span>
  </div>

  <figure class="showcase-frame">
    {
      showcase.status === "ready" && showcasePath ? (
        <img
          src={siteHref(showcasePath, baseUrl)}
          alt="Derived Git Fanta project showcase showing a Git history workflow and the Git Fanta brand."
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
        />
      ) : (
        <div
          class="showcase-frame__fallback"
          role="img"
          aria-label="Git Fanta project showcase unavailable"
        >
          <span aria-hidden="true">git show --stat</span>
          <strong>Product media is being prepared.</strong>
        </div>
      )
    }
    <figcaption>
      Derived project showcase media composed from supplied project assets. It
      is presented as a visual mood piece, not as an independently verified
      application screenshot.
    </figcaption>
  </figure>
</section>
